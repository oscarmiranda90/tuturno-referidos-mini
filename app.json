{
  "expo": {
    "name": "Tu Turno · Referidos",
    "slug": "tuturno-referidos-mini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tuturnoreferidos",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tuturno.referidosdemo"
    },
    "android": {
      "package": "com.tuturno.referidosdemo"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-system-ui",
      [
        "react-native-share",
        {
          "ios": [
            "whatsapp"
          ],
          "android": [
            "com.whatsapp",
            "com.whatsapp.w4b"
          ]
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}
